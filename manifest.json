{
  "manifest_version": 3,
  "name": "VisasPro DS-160 AutoFill",
  "version": "1.24.2",
  "description": "Extrae datos del PDF de VisasPro y llena automáticamente el formulario DS-160. Usa Claude API para traducción automática ES→EN.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://ceac.state.gov/*",
    "https://api.anthropic.com/*",
    "https://api.clickup.com/*",
    "https://ais.usvisa-info.com/*"
  ],
  "action": {
    "default_title": "VisasPro DS-160",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ceac.state.gov/*"],
      "js": ["mappings.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ais.usvisa-info.com/*"],
      "js": ["content-citas.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "lib/*.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}
